# Backend environment variables. Copy to backend/.env for local development:
#     cp .env.example .env
# backend/.env is excluded from version control; never commit real values here.
# manage.py loads backend/.env; production reads the platform's environment instead.

# Settings module: config.settings.development locally, config.settings.production
# on the deployed service.
DJANGO_SETTINGS_MODULE=config.settings.development

# Django signing secret. Required in production. Optional locally: when unset a random
# per-process value is used and sessions end whenever the server restarts.
DJANGO_SECRET_KEY=<generate-a-long-random-value>

# JWT (HS256) signing secret, distinct from DJANGO_SECRET_KEY. Same rules as above.
JWT_SIGNING_KEY=<generate-a-different-long-random-value>

# Comma-separated host names the backend serves. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins (scheme://host[:port]) allowed to make credentialed
# CORS requests and trusted for CSRF. Required in production; no wildcards.
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL connection URL, postgres://<user>:<password>@<host>:<port>/<database>.
# Required in production. Leave unset locally to use backend/db.sqlite3.
DATABASE_URL=

# Local development only: Django debug mode (production always runs with DEBUG off).
DJANGO_DEBUG=true

# Production only: redirect plain-HTTP requests to HTTPS (default true).
DJANGO_SECURE_SSL_REDIRECT=true
