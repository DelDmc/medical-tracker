# Frontend environment variables. Copy to frontend/.env.local for local development:
#     cp .env.example .env.local
# Vite exposes only VITE_-prefixed variables to the browser, so never put a secret here.

# Origin of the backend API, without a trailing slash and without /api/v1.
# Locally, use the same host name as the frontend (localhost) so the SameSite=Lax
# authentication cookies are sent. In production, the deployed backend origin (HTTPS).
VITE_API_BASE_URL=http://localhost:8000
